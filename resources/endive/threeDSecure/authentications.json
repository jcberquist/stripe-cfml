{
    "methods": {
        "cancel": {
            "httpMethod": "post",
            "path": "/v1/three_d_secure/authentications/{authentication_id}/cancel"
        },
        "create": {
            "arguments": {
                "amount": "currency",
                "channel": {
                    "browser": {
                        "java_enabled": "boolean",
                        "javascript_enabled": "boolean"
                    }
                },
                "currency": "iso_currency_code",
                "future_usage": {
                    "installment": {
                        "amount": "currency"
                    },
                    "recurring": {
                        "amount": "currency"
                    }
                }
            },
            "httpMethod": "post",
            "path": "/v1/three_d_secure/authentications"
        },
        "list": {
            "arguments": {
                "created": "datefilter"
            },
            "path": "/v1/three_d_secure/authentications"
        },
        "retrieve": {
            "path": "/v1/three_d_secure/authentications/{authentication_id}"
        },
        "submit": {
            "httpMethod": "post",
            "path": "/v1/three_d_secure/authentications/{authentication_id}/submit"
        }
    }
}
