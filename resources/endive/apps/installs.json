{
    "methods": {
        "create": {
            "httpMethod": "post",
            "path": "/v1/apps/installs"
        },
        "list": {
            "arguments": {
                "approval_required": "boolean",
                "created": "datefilter"
            },
            "path": "/v1/apps/installs"
        },
        "retrieve": {
            "path": "/v1/apps/installs/{install_id}"
        },
        "uninstall": {
            "httpMethod": "post",
            "path": "/v1/apps/installs/{install_id}/uninstall"
        },
        "update": {
            "httpMethod": "post",
            "path": "/v1/apps/installs/{install_id}"
        }
    }
}
